  "sent": [
    {
      "at": "2026-10-04T09:45:31.163230+00:00",
      "kind": "nested",
      "target_id": "18097241951550567",
      "target_username": "gongbubangpanamthinkbig",
      "reply_id": "17989445876996073",
      "text_hash": "e3c2f684ee8a1e1c514b",
      "text": "양띠 인연·가족 흐름은 귀한 인연이 들어오는 따뜻한 흐름입니다.",
      "verified_replied_to": "18097241951550567",
      "revenue_cta": false,
      "date_kst": "2026-10-04"
    },
    {
      "at": "2026-10-10T12:29:34.568299+00:00",
      "kind": "inbound",
      "target_id": "17888506107685397",
      "target_username": "sajangflow",
      "reply_id": "18112473326607775",
      "text_hash": "70e2d064df841d119fba",
      "text": "반할 정도라니 고마워! 너는 평소에 사주나 운세 자주 보는 편이야?",
      "verified_replied_to": "17888506107685397",
      "revenue_cta": false,
      "date_kst": "2026-10-10"
    },
    {
      "at": "2026-10-10T12:29:47.224990+00:00",
      "kind": "inbound",
      "target_id": "17895774186416797",
      "target_username": "nanalifetip",
      "reply_id": "18021489215942105",
      "text_hash": "070407258cbf5057242a",
      "text": "반가워요! 혹시 평소에 사주나 십성에 관심이 많으신가요?",
      "verified_replied_to": "17895774186416797",
      "revenue_cta": false,
      "date_kst": "2026-10-10"
    },
    {
      "at": "2026-10-10T15:25:28.884803+00:00",
      "kind": "nested",
      "target_id": "18640485448000375",
      "target_username": "sajangflow",
      "reply_id": "18186559876411824",
      "text_hash": "c96cd5e8bb202d4a83d5",
      "text": "일 년에 한 번이면 딱 적당하지! 보통 신년 운세 볼 때 많이 찾아보나 봐?",
      "verified_replied_to": "18640485448000375",
      "revenue_cta": false,
      "date_kst": "2026-10-11"
    },
    {
      "at": "2026-10-11T05:51:35.154390+00:00",
      "date_kst": "2026-10-11",
      "kind": "nested",
      "target_id": "17922622077440689",
      "target_username": "sajangflow",
      "reply_id": "18092732393453775",
      "text_hash": "a88585789b47abab7e02",
      "text": "맞장구쳐줘서 고마워 ㅋ 혹시 너는 어떤 십성이 제일 많이 나왔어?",
      "verified_replied_to": "17922622077440689",
      "source_query": "",
      "search_type": "",
      "candidate_score": 990.367,
      "relevance": 0,
      "conversation_signal": 0.0,
      "effect": "CONFIRMED",
      "revenue_cta": false,
      "finalized_at": "2026-10-11T05:51:47.463746+00:00"
    },
    {
      "at": "2026-10-15T17:10:15.273098+00:00",
      "date_kst": "2026-10-16",
      "kind": "inbound",
      "target_id": "18424689436159462",
      "target_username": "candylove7486",
      "reply_id": "18118116509060482",
      "text_hash": "147643f58e38d4449079",
      "text": "재물운만 보면, 원국에 재성이 2곳 잡혀 있어서 돈 흐름이 아예 약한 사주는 아니에요.\n\n올해 병오에는 정재·편재가 들어와서 고정수입·계약·재정관리이 두드러지고, 수입·계약·현금흐름을 실제 숫자로 챙길수록 유리해요.\n\n특히 다음 재성 흐름은 2027년에 다시 잡히니, 지금은 무리하게 크게 벌리기보다 그때까지 돈 되는 구조를 만들어두는 게 좋아요.",
      "verified_replied_to": "18424689436159462",
      "source_query": "",
      "search_type": "",
      "candidate_score": 999.654,
      "relevance": 0,
      "conversation_signal": 0.0,
      "effect": "CONFIRMED",
      "revenue_cta": false,
      "finalized_at": "2026-10-15T17:10:26.396540+00:00"
    },
    {
      "at": "2026-10-15T17:11:06.346385+00:00",
      "date_kst": "2026-10-16",
      "kind": "inbound",
      "target_id": "18184636828421155",
      "target_username": "hahahaha235711",
      "reply_id": "18152879053530340",
      "text_hash": "f8878942acb7356bd270",
      "text": "재물운만 볼게요. 출생시간이 없어서 시주는 빼고, 연·월·일 기준으로 돈 흐름만 보겠습니다.\n\n올해 병오에는 정관·편관가 들어와서 직위·조직·규정·문서이 두드러지고, 돈 자체보다 일의 변화가 먼저 움직이고 그 뒤에 수입이 따라오는 흐름이에요.\n\n특히 다음 재성 흐름은 2034, 2035년에 다시 잡히니, 지금은 무리하게 크게 벌리기보다 그때까지 돈 되는 구조를 만들어두는 게 좋아요.",
      "verified_replied_to": "18184636828421155",
      "source_query": "",
      "search_type": "",
      "candidate_score": 998.774,
      "relevance": 0,
      "conversation_signal": 0.0,
      "effect": "CONFIRMED",
      "revenue_cta": false,
      "finalized_at": "2026-10-15T17:11:17.913492+00:00"
    },
    {
      "at": "2026-10-16T16:45:37.809066+00:00",
      "date_kst": "2026-10-17",
      "kind": "inbound",
      "target_id": "17907203694603599",
      "target_username": "busanmom",
      "reply_id": "17916992439263580",
      "text_hash": "8640ddc79c37b9144d21",
      "text": "말띠 전체 흐름은 오늘은 갑자일, 오늘 기운과 정면으로 부딪히는 날 — 큰 결정이나 다툼은 한 박자 쉬어가면 오히려 득.",
      "verified_replied_to": "17907203694603599",
      "source_query": "",
      "search_type": "",
      "candidate_score": 999.827,
      "relevance": 0,
      "conversation_signal": 0.0,
      "effect": "CONFIRMED",
      "revenue_cta": false,
      "finalized_at": "2026-10-16T16:45:50.077368+00:00"
    },
    {
      "at": "2026-10-16T16:45:51.424370+00:00",
      "date_kst": "2026-10-17",
      "kind": "inbound",
